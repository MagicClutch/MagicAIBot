[minecraft]
server = "127.0.0.1:25565"
username = "MagicBot"
account_mode = "offline"

[reconnect]
enabled = false
delay_seconds = 10
maximum_attempts = 5

[console]
enabled = true
send_plain_input_to_chat = false
show_system_messages = true
show_action_bar_messages = false

[logging]
level = "info"
debug = false

[groq]
# Groq is the AI provider (OpenAI-compatible API).
enabled = true
# llama-3.1-8b-instant is Groq's fastest model that reliably supports tool
# calling and is available on the free tier — this is the main speed lever.
# Fallbacks only kick in on rate limits/daily caps, so they can be larger.
model = "llama-3.1-8b-instant"
fallback_models = ["llama-3.3-70b-versatile", "mixtral-8x7b-32768"]
# base_url = "https://api.groq.com/openai/v1"

# Direct API key (preferred — do not commit this file if set here)
# api_key = "YOUR_GROQ_API_KEY"

# Optional fallback environment variable name
api_key_env = "GROQ_API_KEY"
request_timeout_seconds = 60
max_request_retries = 3
temperature = 0.1
# Caps generation length per turn (tool call or chat reply). Lower is
# faster; each turn only needs one tool call or one short sentence.
max_completion_tokens = 250
include_nearby_entities = true
include_inventory = true

[groq.limits]
max_gather_quantity = 64
max_mine_quantity = 64
max_craft_quantity = 64
max_navigation_distance = 256
max_actions_per_session = 30
max_replans_per_session = 8
max_session_seconds = 600
allow_mining = true
allow_crafting = true
allow_containers = true
allow_block_placement = true

[groq.rate_limits]
respect_retry_after = true
maximum_retry_delay_seconds = 3600
switch_model_on_daily_limit = true
switch_model_on_rate_limit = true

[groq.context]
max_chat_messages = 8
max_inventory_entries = 36
max_nearby_entities = 12
max_nearby_blocks = 32
max_previous_action_results = 4
include_full_command_descriptions = true

# Local AI server. Despite the section name this works for Ollama OR LM
# Studio OR anything else exposing an OpenAI-compatible /v1/chat/completions
# endpoint -- only base_url/model need to change. No API key needed. Set
# [ai] provider = "ollama" above to use this instead of Groq.
# Most small/quantized models do NOT reliably support tool calling, which
# this whole bot depends on -- stick to models documented as tool-capable.
#
# Ollama (https://ollama.com): run `ollama serve`, pull a model first
#   (`ollama pull llama3.1`), base_url = "http://localhost:11434/v1"
# LM Studio (https://lmstudio.ai): load a model and start its local server
#   (Developer tab -> Start Server), base_url = "http://localhost:1234/v1",
#   model = the identifier shown in LM Studio for the loaded model
[ollama]
enabled = false
base_url = "http://localhost:11434/v1"
model = "llama3.1"
request_timeout_seconds = 120
max_request_retries = 1
temperature = 0.1
max_tokens = 250

# Legacy Gemini configuration (deprecated - use [groq] instead).
[gemini]
enabled = false
api_key_env = "GEMINI_API_KEY"
model = "gemini-2.5-flash"
request_timeout_seconds = 30
max_request_retries = 2
max_steps_per_session = 30
max_session_seconds = 600
temperature = 0.1
include_nearby_blocks = true
include_nearby_entities = true
include_inventory = true

[gemini.limits]
max_gather_quantity = 64
max_mine_quantity = 64
max_craft_quantity = 64
max_navigation_distance = 256
max_actions_per_session = 30
max_replans_per_session = 8
max_session_seconds = 600
allow_mining = true
allow_crafting = true
allow_containers = true
allow_block_placement = true

[ai]
# "groq" (cloud, fast, free tier) or "ollama" (local, no network round trip,
# speed depends entirely on your hardware and chosen model). Only the
# selected provider's config section below is used.
provider = "groq"
busy_behavior = "reject"

[ai.chat]
enabled = true
prefix = "!"
# false = every player chat message is treated as an AI request, not just
# ones starting with `prefix`. access/rate_limit below still apply, but
# there is no way to distinguish "talking to the bot" from ambient chat
# between other players once this is off -- expect it to respond to things
# not meant for it, and to burn through rate limits faster on busy servers.
require_prefix = true
respond_in_chat = true
accept_console_ai_command = true
acknowledge_requests = true
strip_prefix_whitespace = true
max_request_length = 500
incoming_queue_capacity = 64

[ai.chat.access]
operators_only = false # Operator state is not currently exposed reliably; use lists below.
allowed_players = []
blocked_players = []

[ai.chat.rate_limit]
enabled = true
requests = 3
window_seconds = 30
# Logs stay local and are never relayed to Minecraft chat. Operation correlation
# IDs are random diagnostics identifiers; account/session secrets are not logged.

[world_state]
nearby_entity_radius = 64
maximum_tracked_entities = 256
stale_entity_seconds = 30

[movement]
follow_distance = 3.0
# This also paces the main tick loop (chat/AI polling, arrival detection),
# so lower = snappier overall, at the cost of slightly more CPU/pathfinding
# chatter. 150 is a fast-but-safe default; the valid range is 50-10000.
repath_interval_ms = 150
arrival_distance = 1.5

# Disabled by default: construction and excavation change the world.
[vertical_navigation]
enabled = true
allow_pillaring = true
allow_digging_down = true
prefer_staircase_descent = true
max_pillar_height = 32
max_dig_depth = 64
minimum_building_blocks = 4
# Building material is a deny-list, not an allow-list: the bot may use any
# placeable block it holds except src/bridging's built-in blacklist
# (containers, valuables, redstone, decorative blocks, crops, etc.) plus
# anything listed here.
denied_building_blocks = ["minecraft:diamond_block", "minecraft:chest", "minecraft:crafting_table"]

# Baritone-style "fast bridging": walk normally across each placed block,
# only sneaking for the brief moment needed to place the next one near the
# edge. This is the default bridge-move technique for every /goto, /follow,
# and task -- set fast_bridge_enabled = false to fall back to the original
# permanent-sneak technique.
[bridging]
fast_bridge_enabled = true
edge_threshold = 0.18

[multitasking]
normal_forward_angle = 35.0
strafe_angle = 75.0
backward_angle = 130.0
extreme_angle = 160.0

[block_search]
default_radius = 32
maximum_radius = 128
default_result_limit = 20
maximum_result_limit = 256
default_vertical_range = 32

[block_navigation]
default_search_radius = 32
maximum_search_radius = 128
candidate_limit = 20
interaction_distance = 4.5
arrival_distance = 1.5
maximum_target_attempts = 10
stuck_timeout_seconds = 12
maximum_navigation_seconds = 120
repath_interval_ms = 1000

[look]
update_rate = 20
reaction_delay_min_ms = 35
reaction_delay_max_ms = 90
moving_target_prediction = true
prediction_strength = 0.35
minimum_target_movement = 0.03

[look.randomization]
enabled = true
block_randomization = true
entity_randomization = true
player_randomization = true
horizontal_strength = 0.35
vertical_strength = 0.30
minimum_hold_time_ms = 350
maximum_hold_time_ms = 1200
retarget_chance_per_second = 0.35

[look.motion]
minimum_yaw_speed = 25.0
maximum_yaw_speed = 220.0
minimum_pitch_speed = 20.0
maximum_pitch_speed = 160.0
yaw_acceleration = 600.0
pitch_acceleration = 450.0
yaw_deceleration = 700.0
pitch_deceleration = 550.0
slowdown_angle = 18.0
arrival_tolerance = 1.2
micro_correction_enabled = true
micro_correction_strength = 0.35
speed_variation = 0.10
overshoot_chance = 0.08
maximum_overshoot_degrees = 1.8

[interaction]
maximum_reach = 4.5
placement_reach = 4.5
breaking_reach = 4.5
retry_limit = 3
retry_delay_ms = 150
verification_timeout_ms = 1500
auto_navigate = true
auto_precise_look = true
# Select the best suitable tool currently in the hotbar before breaking.
auto_tool_switch = true
# Preserve at least this many uses; unknown durability remains eligible.
minimum_tool_durability = 2
# Only applies to blocks that do not require a correct harvesting tool.
allow_hand_fallback = true
# Keep the held tool when it is within 10% of the best candidate's speed.
held_tool_equivalence = 0.10
# Exact item IDs that automatic breaking must not select.
protected_tools = []
# Exact item IDs temporarily reserved for other tasks.
reserved_tools = []
# Intentional breaking uses this interaction controller. Pathfinder mining is a
# separate, explicit command mode (`/goto-mine` or `mine` on `/gotoblock`).

[interaction.face_targeting]
face_inset = 0.001
edge_margin = 0.12
maximum_face_attempts = 6
maximum_hit_points_per_face = 5

[smelting]
station_search_radius = 32
observation_interval_ms = 250
confirmation_timeout_ms = 3000
total_timeout_seconds = 300
reopen_limit = 2
# Inventory cleanup is deny-by-default: with no rules every item is kept.
# Rules are evaluated deterministically; exact item rules beat tag rules and
# the first rule wins ties. `discard` is the only authorization to drop.
[inventory_cleanup]
protect_rare_items = true
protect_tools = true
rules = []
# Conservative loaded-world tree recognition. It never crafts, builds, climbs, or replants.
[tree_chopping]
allowed_tree_types = ["oak", "birch", "spruce", "jungle", "acacia", "dark_oak", "mangrove", "cherry", "pale_oak"]
require_nearby_leaves = true
maximum_connected_logs = 192
maximum_tree_height = 48
maximum_branch_distance = 12
maximum_horizontal_logs = 48
break_leaves = false
collect_saplings = true
allow_hand_chopping = false
search_radius = 32
maximum_trees = 16
total_timeout_seconds = 300
[ensure_tool]
# Highest preference first. Unsupported or insufficient tiers are skipped.
material_tier_preference = ["iron", "stone", "wood"]
# A tool at or below this remaining durability is not eligible.
durability_reserve = 10
# Uses the existing furnace executor when a recipe dependency requires it.
allow_smelting = false
