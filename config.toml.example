[minecraft]
server = "127.0.0.1:25565"
username = "MagicBot"
account_mode = "offline"

[reconnect]
enabled = false
delay_seconds = 10
maximum_attempts = 5

[console]
enabled = true
send_plain_input_to_chat = false
show_system_messages = true
show_action_bar_messages = false

[logging]
level = "info"
debug = false

# How much of the bot's OWN status narration (task started/progress/
# finished -- not raw player chat) is shown, independently for the local
# console/run window and for Minecraft chat. Change at runtime with
# `/outputmode <console|chat|both> <mode>`; see `/explanation` in-game or in
# the console for the same explanation as below.
#
#   none      - nothing at all
#   light     - only a task's start and its final outcome
#               (e.g. "Get task started: diamond x5", "Collected 5 diamond")
#   info      - light, plus a running progress report as a task makes
#               headway (e.g. "Collected diamond (3/5)")
#   debug     - info, plus every other diagnostic line the bot prints
#               (connection state, per-step narration, retries, ...)
#   fulldebug - debug, but also disables repeat-collapsing so a stuck retry
#               loop prints every repetition -- for troubleshooting only
[output]
console = "info"
chat = "info"

# Standalone PvP (`#kill <player>`/`/kill <player>`, `src/combat/`) --
# entirely independent of movement/pathfinding, see that module's doc
# comment. The bot fights in full aggression: it never retreats and never
# breaks off a fight to heal, it just keeps closing the gap and swinging
# until the target is dead. `preferred_range` is the hold distance it
# circles at once it's there (see `combat::movement`).
# `heal_threshold` and `finisher_health` are HP on the vanilla 0-20 scale
# (4 hearts = 8). Eating happens mid-fight without disengaging: one bite when
# the bot drops below `heal_threshold`, then it commits to the fight for
# `eat_cooldown_ms` before considering another. Once the *target* falls to
# `finisher_health` the bot stops eating altogether and just finishes them.
[killbot]
attack_range = 2.0
# Milliseconds between hits, or 0 (the default) for automatic: swing exactly
# when the weapon in hand finishes recharging -- 625ms for any sword, 1000ms
# for a netherite axe. Automatic is the maximum-damage setting: Java scales
# each hit by 0.2 + 0.8*(charge^2), so hitting at half charge deals 40%
# damage at twice the rate, i.e. 0.8x the DPS of just waiting. Set an
# explicit value only if you want a specific cadence; anything below the
# weapon's real recharge time costs damage. Governs `#kill` and `#get <mob>`
# alike.
attack_cooldown_ms = 0
preferred_range = 1.8
crit_enabled = true
# Never swing a sword flat-footed: if the cooldown comes up while the bot is
# standing on the ground, jump and hold the hit until it lands as a critical
# (1.5x damage). Costs ~0.3s on those hits and more than pays for it. A bot
# that physically cannot jump (low ceiling, one-block tunnel) swings normally
# after a moment instead of freezing. Sword-only -- an axe's slower cooldown
# already leaves room for the ordinary crit jump.
always_crit_with_sword = true
shield_break_enabled = true
shield_use_enabled = true
heal_threshold = 8.0
# One bite at a time: after swallowing, the bot goes straight back to
# fighting and won't reach for food again for this long. Defaults to a golden
# apple's own Regeneration II duration -- a gap heals 4 HP gradually over 5s,
# so without this wait the bot re-checks its health the moment the apple
# lands, still sees it low, and eats another, chewing through a whole stack
# instead of fighting. 0 chains bites back to back.
eat_cooldown_ms = 5000
# Target HP at or below which the bot ignores its own health and just
# attacks -- a target this close to death dies to the next couple of hits,
# and stopping to eat hands them the fight. 0 disables the rule.
finisher_health = 8.0
sprint_reset_enabled = true
strafe_enabled = true
prediction_enabled = true
max_chase_distance = 128.0

# Baritone-style long-distance navigation (`src/pathfinding/`). Plans the
# route and slices it into segments; each segment is still walked by
# `[movement]`/`[vertical_navigation]` below. `/goto <x> <y> <z>` uses this
# automatically once the destination is farther than
# `long_distance_threshold`; shorter hops go straight to the movement layer
# exactly as before. `debug_pathfinding` turns on the `[Pathfinder]`
# narration (route plans, per-segment progress, every replan and its
# reason). `/pathstatus` reports the current segment either way.
[pathfinding]
enabled = true
debug_pathfinding = false
long_distance_threshold = 96.0
segment_length = 48.0
sample_margin = 24
vertical_window = 32
max_search_nodes = 20000
search_timeout_ms = 1500
arrival_radius = 1.5
segment_arrival_radius = 3.0
segment_stuck_seconds = 12
max_consecutive_replans = 8
cache_capacity = 4096
cache_max_age = 8192
allow_breaking = true
# Intersected with [vertical_navigation]'s own build permissions: turning
# building off there also stops the planner routing bridges.
allow_bridging = true
allow_swimming = true
max_drop = 8

# What each kind of movement is worth, in units of "one block of easy
# walking" -- so `break_block = 6.0` reads as "mining one block out of the
# way is worth walking six blocks around it". Raise `lava_avoidance` or
# `hazard` to make the bot more cautious, lower `break_block` to make it dig
# more readily. Every weight must be greater than zero.
[pathfinding.costs]
walk = 1.0
diagonal = 1.41
jump_up = 1.8
drop_per_block = 1.1
max_safe_drop = 3
fall_damage_penalty = 20.0
swim = 3.0
break_block = 6.0
bridge_block = 8.0
climb = 2.5
hazard = 40.0
lava_avoidance = 200.0
hazard_proximity = 6.0
ledge_proximity = 1.0
entity_hazard = 25.0

# A player can run a real console command directly from Minecraft chat with
# a `#` prefix, e.g. `#goto 100 64 20` runs exactly what `/goto 100 64 20`
# would in the local console. `/quit` can never be run this way.
[chat_commands]

[chat_commands.access]
operators_only = false # Operator state is not currently exposed reliably; use lists below.
allowed_players = []
blocked_players = []

[chat_commands.rate_limit]
enabled = true
requests = 3
window_seconds = 30

[world_state]
# 256 is the hard maximum this app allows (see Config::validate).
nearby_entity_radius = 256
maximum_tracked_entities = 256
stale_entity_seconds = 30

[movement]
follow_distance = 3.0
# This also paces the main tick loop (chat/AI polling, arrival detection),
# so lower = snappier overall, at the cost of slightly more CPU/pathfinding
# chatter. 150 is a fast-but-safe default; the valid range is 50-10000.
repath_interval_ms = 150
arrival_distance = 1.5
# How long a movement command tolerates the bot's distance to its
# destination not improving before giving up -- a bot still making
# progress, however slowly, never trips this no matter how long the trip
# takes overall. maximum_navigation_seconds is a much longer, rarely-hit
# absolute backstop on top of it.
stuck_timeout_seconds = 12
maximum_navigation_seconds = 900

# Disabled by default: construction and excavation change the world.
[vertical_navigation]
enabled = true
allow_pillaring = true
allow_digging_down = true
prefer_staircase_descent = true
max_pillar_height = 32
max_dig_depth = 64
minimum_building_blocks = 4
# Lowest Y the bot will ever deliberately target: block search results below
# this are never returned as mining/navigation candidates. -59 sits just
# above the Overworld's uneven natural-bedrock band (Y -64 to roughly -60)
# in 1.18+, so ore down to the floor is still reachable without the bot
# wasting time trying to dig or path through blocks that are frequently
# unbreakable bedrock. minecraft:bedrock itself is also never a valid mining
# target regardless of Y.
minimum_y = -59
# Building material is a deny-list, not an allow-list: the bot may use any
# placeable block it holds except src/bridging's built-in blacklist
# (containers, valuables, redstone, decorative blocks, crops, etc.) plus
# anything listed here.
denied_building_blocks = ["minecraft:diamond_block", "minecraft:chest", "minecraft:crafting_table"]

# Baritone-style "fast bridging": walk normally across each placed block,
# only sneaking for the brief moment needed to place the next one near the
# edge. This is the default bridge-move technique for every /goto, /follow,
# and task -- set fast_bridge_enabled = false to fall back to the original
# permanent-sneak technique.
[bridging]
fast_bridge_enabled = true
edge_threshold = 0.18

[multitasking]
normal_forward_angle = 35.0
strafe_angle = 75.0
backward_angle = 130.0
extreme_angle = 160.0

[block_search]
# 256/384 are the hard maximums this app allows (see Config::validate).
default_radius = 256
maximum_radius = 256
default_result_limit = 20
maximum_result_limit = 256
default_vertical_range = 384

[block_navigation]
default_search_radius = 256
maximum_search_radius = 256
candidate_limit = 20
interaction_distance = 4.5
arrival_distance = 1.5
maximum_target_attempts = 10
stuck_timeout_seconds = 12
maximum_navigation_seconds = 120
repath_interval_ms = 1000

[look]
update_rate = 30
# Human reaction latency before the aim starts moving toward a new target.
reaction_delay_min_ms = 10
reaction_delay_max_ms = 28
moving_target_prediction = true
prediction_strength = 0.35
minimum_target_movement = 0.03

[look.randomization]
enabled = true
block_randomization = true
entity_randomization = true
player_randomization = true
horizontal_strength = 0.35
vertical_strength = 0.30
minimum_hold_time_ms = 350
maximum_hold_time_ms = 1200
retarget_chance_per_second = 0.35

# Fast, human-like aim: quick to accelerate up to a snappy top speed and
# quick to brake into the target, rather than a slow drifting turn -- but
# still eased motion with overshoot/micro-correction, not an instant snap
# (see `look.randomization`/`precision::LookPrecision::Instant` for that).
#
# Speeds are 2x the original profile and accelerations 4x, which together
# halve the time of a turn whether it is short (acceleration-limited, where
# d = a*t^2/2 means halving the time needs 4x the acceleration) or long
# (top-speed-limited, where it needs 2x). Halve every number in this block to
# get the old, calmer aim back.
[look.motion]
minimum_yaw_speed = 120.0
maximum_yaw_speed = 960.0
minimum_pitch_speed = 100.0
maximum_pitch_speed = 760.0
yaw_acceleration = 8800.0
pitch_acceleration = 7200.0
yaw_deceleration = 10400.0
pitch_deceleration = 8400.0
slowdown_angle = 14.0
arrival_tolerance = 1.2
micro_correction_enabled = true
micro_correction_strength = 0.35
speed_variation = 0.10
overshoot_chance = 0.08
maximum_overshoot_degrees = 1.8

[interaction]
maximum_reach = 4.5
placement_reach = 4.5
breaking_reach = 4.5
retry_limit = 3
retry_delay_ms = 150
verification_timeout_ms = 1500
auto_navigate = true
auto_precise_look = true
# Select the best suitable tool currently in the hotbar before breaking.
auto_tool_switch = true
# Preserve at least this many uses; unknown durability remains eligible.
minimum_tool_durability = 2
# Only applies to blocks that do not require a correct harvesting tool.
allow_hand_fallback = true
# Keep the held tool when it is within 10% of the best candidate's speed.
held_tool_equivalence = 0.10
# Exact item IDs that automatic breaking must not select.
protected_tools = []
# Exact item IDs temporarily reserved for other tasks.
reserved_tools = []
# Intentional breaking uses this interaction controller. Pathfinder mining is a
# separate, explicit command mode (`/goto-mine` or `mine` on `/gotoblock`).

[interaction.face_targeting]
face_inset = 0.001
edge_margin = 0.12
# How many of a block's faces (max 6), and how many points per face, to try
# before giving up and repositioning instead. Each attempt visibly re-aims
# the camera, so keep this low -- 3 faces x 2 points is already up to 6 look
# changes per obstruction, x interaction.retry_limit retries.
maximum_face_attempts = 3
maximum_hit_points_per_face = 2

# Fully automatic equipment: always wear the best available armor and keep
# the offhand stocked with a Totem of Undying (or a Shield, if preferred/no
# totem is held). Re-evaluated continuously, but only actually swaps when
# the change clears the threshold below -- see src/equipment for the
# scoring/selection rules.
[equipment.armor]
# score: ranks each piece 1.0-10.0 from material + current durability, so a
#   badly damaged higher-tier piece can lose to a fully-repaired lower-tier
#   one. Only swaps when the replacement scores at least 0.2 higher.
# rarity: ignores durability and ranks by material alone
#   (Netherite > Diamond > Iron > Chainmail > Copper > Gold > Leather). Only swaps
#   on a strictly higher material tier.
mode = "score"   # score | rarity

[equipment.offhand]
# Which item the offhand prefers when both are available; the other is used
# as a fallback, and the offhand is left alone if neither is held.
priority = "totem"   # totem | shield

# Automatic hotbar equipment: keeps the best sword/pickaxe/axe/shovel/
# building block/water bucket (plus any utility_items below) in a fixed
# hotbar slot, replacing a worse item automatically. Reuses the same scoring
# this file already configures above -- armor.mode's rules, and
# equipment.tools.ranking_mode below for weapons/tools -- rather than a
# separate ranking system. Re-evaluation is event-driven (only when the
# inventory actually changes), with periodic_scan_seconds as a fallback.
[equipment.hotbar]
enabled = true
periodic_scan_seconds = 10

[equipment.hotbar.slots]
sword = 1
pickaxe = 2
axe = 3
shovel = 4
blocks = 5
water_bucket = 6
# Slots 7-9 are left free for manual use / other items by default.

# Extra items to keep stocked in a specific hotbar slot by exact item id,
# regardless of any scoring -- just kept there whenever held anywhere in the
# inventory. Repeat this table for each extra item.
# [[equipment.hotbar.utility_items]]
# item_id = "minecraft:totem_of_undying"
# slot = 9

[equipment.tools]
# rarity (default): rank pickaxe/axe/shovel/sword purely by material tier
#   (wood < gold < stone < iron < diamond < netherite), like armor's
#   "rarity" mode.
# score: rank by a material-tier-derived score minus a durability penalty,
#   like armor's "score" mode -- a damaged higher tier can lose to a
#   pristine lower one.
ranking_mode = "rarity"   # rarity | score

# Automatic dropping of whatever a hotbar/armor replacement just displaced.
# Never touches the item currently equipped -- only ever drops the item a
# *successful* swap just displaced, and only after that swap is confirmed.
[equipment.autodrop]
enabled = true
# Item ids never auto-dropped regardless of scoring, e.g. a spare tool kept
# on purpose.
protected_items = []

[equipment.autodrop.armor]
# Off by default: players often want to keep backup armor.
enabled = false
drop_when_better_available = true

[equipment.autodrop.tools]
enabled = true
drop_when_better_available = true

[equipment.autodrop.weapons]
enabled = true
drop_when_better_available = true
